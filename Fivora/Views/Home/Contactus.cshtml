@{
    ViewBag.Title = "Contact Fivora Group | Financial Consultation in Surat";
    ViewBag.MetaDescription = "Get in touch with Fivora Group for expert loan, insurance, and investment services in Surat. Call us or visit our office in Pal, Adajan today!";
    ViewBag.MetaKeywords = "contact Fivora Group, loan consultation Surat, investment services, financial advisors, business consultation, Surat finance experts";
}

<section class="breadcrumbSetion ContactusBreadcrumb">
    <div class="container-fluid">
        <div class="row">
            <div class="col-12 text-center">
                <h3 class="breadcrumb-title">Contact <span>Us</span></h3>
            </div>
        </div>
    </div>
</section>

<section class="ContactSection section-gap">
    <div class="WrapperContainer">
        <div class="container-fluid">
            <div class="row">
                <div class="col-lg-4">
                    <div class="contactBox">
                        <div class="Contactimage">
                            <img src="~/images/icons/phone-call.png" class="img-fluid" alt="Phone-call" />
                        </div>
                        <h3>Phone</h3>
                        <a href="tel:+916357312993">+91 63573 12993</a>
                    </div>
                </div>
                <div class="col-lg-4">
                    <div class="contactBox">
                        <div class="Contactimage">
                            <img src="~/images/icons/location.png" class="img-fluid" alt="Location" />
                        </div>
                        <h3>Address</h3>
                        <a href="https://maps.app.goo.gl/sexe2QCGb8VqPENU9" target="_blank">227, Sumeru Business Corner, Nr.Radisson Hotel, Rajhans Cinema Road, Pal, Adajan, Surat- 395009</a>
                    </div>
                </div>
                <div class="col-lg-4">
                    <div class="contactBox">
                        <div class="Contactimage">
                            <img src="~/images/icons/email.png" class="img-fluid" alt="Email" />
                        </div>
                        <h3>Email</h3>
                        <a href="mailto:info@fivoragroup.in">info@fivoragroup.in</a>
                    </div>
                </div>

            </div>
        </div>
    </div>
</section>

<section class="formSection section-gap">
    <div class="WrapperContainer">
        <div class="container-fluid">
            <div class="row">
                <div class="col-lg-6">
                    <div class="ContactForm">
                        <h2>Get In Touch</h2>
                        <form class="form-row">
                            <div class="col-md-6">
                                <div class="form-group">
                                    <input type="text" class="form-control" placeholder="Your Name" required>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-group">
                                    <input type="text" class="form-control" placeholder="Email Address" required>
                                </div>
                            </div>
                            <div class="col-md-12">
                                <div class="form-group">
                                    <input type="number" class="form-control" placeholder="Contact Number" required />
                                </div>
                            </div>
                            <div class="col-md-12">
                                <div class="form-group">
                                    <textarea class="form-control" id="exampleFormControlTextarea1" rows="4" placeholder="Message.."></textarea>
                                </div>
                            </div>
                            <div class="col-12">
                                <div class="FivoraCardButton">
                                    <a href="#">Send Message <i class="fas fa-arrow-right" aria-hidden="true"></i></a>
                                </div>
                            </div>
                        </form>
                    </div>
                </div>
                <div class="col-lg-6">
                    <div class="mapArea">
                        <iframe src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3720.1263934934354!2d72.7858421!3d21.187137399999997!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x3be04d4ee12bed6b%3A0x48c3af8b0ef13ae8!2sSUMERRU%20BUSINESS%20CORNER!5e0!3m2!1sen!2sin!4v1743245567906!5m2!1sen!2sin" width="100%" height="490" style="border:0;" allowfullscreen="" loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe>
                    </div>
                </div>

            </div>
        </div>
    </div>
</section>