<section class="SliderSection">
    <div id="carouselExampleCaptions" class="carousel slide carousel-fade" data-ride="carousel">
        <ol class="carousel-indicators">
            <li data-target="#carouselExampleIndicators" data-slide-to="0" class="active"></li>
            <li data-target="#carouselExampleIndicators" data-slide-to="1"></li>
        </ol>
        <div class="carousel-inner">
            <div class="carousel-item active">
                <img src="~/images/sliders/slider1.jpg" class="img-fluid" alt="Slider 1">
                <div class="carousel-caption">
                    <h5>Grow Your Wealth, Secure Your Future!</h5>
                    <p>Invest smartly today to build a financially secure tomorrow.</p>
                </div>
            </div>
            <div class="carousel-item">
                <img src="~/images/sliders/slider2.jpg" class="img-fluid" alt="Slider 2">
                <div class="carousel-caption">
                    <h5>Protecting Dreams, Securing Lives!</h5>
                    <p>Ensure your family's future with a life insurance plan that truly cares.</p>
                </div>
            </div>
        </div>
        <div class="sliderButton">
            <button class="carousel-control-next" type="button" data-target="#carouselExampleCaptions" data-slide="next">
                <i class="fas fa-chevron-right"></i>
            </button>
            <button class="carousel-control-prev" type="button" data-target="#carouselExampleCaptions" data-slide="prev">
                <i class="fas fa-chevron-left"></i>
            </button>
        </div>
    </div>
</section>

