@{
    ViewBag.Title = "About Fivora Group | Trusted Financial Services in Surat";
    ViewBag.MetaDescription = "Learn more about Fivora Group, a leading financial services provider in Pal, Adajan, Surat, offering expert solutions in loans, insurance, and investments.";
    ViewBag.MetaKeywords = "about Fivora Group, financial experts Surat, loan providers, insurance specialists, investment advisors, business growth, Surat finance services";
}

<section class="breadcrumbSetion AboutusBreadcrumb">
    <div class="container-fluid">
        <div class="row">
            <div class="col-12 text-center">
                <h3 class="breadcrumb-title">About <span>Us</span></h3>
            </div>
        </div>
    </div>
</section>

<section class="aboutSection section-gap">
    <div class="WrapperContainer">
        <div class="container-fluid">
            <div class="row">
                <div class="col-lg-8">
                    <div class="headingBar marginBottom25">
                        <h1>Your Trusted Partner in <span> Financial Growth & Security</span></h1>
                    </div>
                    <div class="MissionVision">
                        @* <div class="experienceLane owl-carousel">
                            <div class="Digit">
                                <h5>30 <i class="fas fa-plus"></i></h5>
                                <p>Years Experience</p>
                            </div>
                            <div class="Digit">
                                <h5>25 <i class="fas fa-plus"></i></h5>
                                <p>Winning Awards</p>
                            </div>
                        </div> *@
                        <div class="AboutMe">
                            <p><span>About Us:</span> Fivora Group is a leading financial services provider in Surat, offering expert solutions in <span>Loans, Insurance, Investments, and Business Opportunities</span>. We are committed to helping individuals and businesses achieve financial success with personalized and reliable services. Our expertise, transparency, and customer-first approach ensure that you make informed financial decisions with confidence. At Fivora Group, we believe in building long-term trust and financial security for a brighter future.</p>
                            <p><span>Mission:</span> To provide innovative and customer-focused financial solutions, empowering individuals and businesses to achieve financial success.</p>
                            <p><span>Vision: </span>To be a trusted leader in financial services, delivering excellence, transparency, and long-term value to our clients.</p>
                        </div>
                    </div>
                </div>
                <div class="col-lg-4" id="setAlignment">
                    <div class="layerImage">
                        <img src="~/images/aboutinner.jpg" class="img-fluid" alt="About us Image" />
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="RatingTrack section-gap">
    <div class="WrapperContainer">
        <div class="container-fluid">
            <div class="row">
                <div class="col-md-6 col-lg-3 col-sm-6">
                    <div class="RatingSection">
                        <div class="ratingDigit">
                            <h6 class="timer count-title count-number counter" data-target="40"></h6>
                        </div>
                        <p><label>+</label>Team<br />Members</p>
                    </div>
                </div>
                <div class="col-md-6 col-lg-3 col-sm-6">
                    <div class="RatingSection">
                        <div class="ratingDigit">
                            <h6 class="timer count-title count-number counter" data-target="10"></h6>
                        </div>
                        <p><label>+</label>Awards<br />Winning</p>
                    </div>
                </div>
                <div class="col-md-6 col-lg-3 col-sm-6">
                    <div class="RatingSection">
                        <div class="ratingDigit">
                            <h6 class="timer count-title count-number counter" data-target="15"></h6>
                        </div>
                        <p><label>+</label>Country<br />Operation</p>
                    </div>
                </div>
                <div class="col-md-6 col-lg-3 col-sm-6">
                    <div class="RatingSection">
                        <div class="ratingDigit">
                            <h6 class="timer count-title count-number counter" data-target="60"></h6>
                        </div>
                        <p><label>K +</label>Happy<br />Customers</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="MeetAgent section-gap">
    <div class="WrapperContainer">
        <div class="container-fluid">
            <div class="row">
                <div class="col-md-12 text-center">
                    <div class="headingBar marginBottom100">
                        <h1>Behind <span>the Vision</span></h1>
                    </div>
                </div>
                <div class="ownerCard">
                    <div class="agentBox">
                        <img src="~/images/owner/NayanVankawala.jpg" class="img-fluid" alt="Nayan B. Vankawala" />
                        <h3>Nayan B. Vankawala</h3>
                        <p>Co Founder</p>
                    </div>
                    <div class="agentBox">
                        <img src="~/images/owner/abhishekrevdiwala.jpg" class="img-fluid" alt="Abhishek Revdiwala" />
                        <h3>Abhishek Revdiwala</h3>
                        <p>Co Founder</p>
                    </div>
                    <div class="agentBox">
                        <img src="~/images/owner/JenishGandhi.jpg" class="img-fluid" alt="Jenish Gandhi" />
                        <h3>Jenish Gandhi</h3>
                        <p>Co Founder</p>
                    </div>
                    <div class="agentBox">
                        <img src="~/images/owner/PrasitReshamwala.jpg" class="img-fluid" alt="Prasit Reshamwala" />
                        <h3>Prasit Reshamwala</h3>
                        <p>Co Founder</p>
                    </div>
                    <div class="agentBox">
                        <img src="~/images/owner/JatinGajjar.jpg" class="img-fluid" alt="Jatin Gajjar" />
                        <h3>Jatin Gajjar</h3>
                        <p>Financial Advisor</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

