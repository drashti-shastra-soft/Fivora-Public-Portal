    <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.2/gsap.min.js"></script>
    <script>
        $( document ).ready(function() {
            //Loader
            $(window).on('load', function () {
                $('#lodeerloder').addClass('hidden'); // Add the 'hidden' class to trigger fadeout animation
            });
            setTimeout(function () {
                $('#lodeerloder').addClass('hidden');
            }, 3000);

            //Add fixed Class in Header
            $(window).scroll(function () {
                if ($(this).scrollTop() > 50) {
                    $('.FivoraHeader').addClass('fixed');
                } else {
                    $('.FivoraHeader').removeClass('fixed');
                }
            });

            $('.FAQAccordian .card-header').on('click', function () {
                var icon = $(this).find('.toggle-icon');

                // First, reset all icons to plus
                $('.FAQAccordian .toggle-icon').removeClass('fa-minus').addClass('fa-plus');

                // Then toggle the clicked one if the related panel is not already shown
                if (!$(this).next('.collapse').hasClass('show')) {
                    icon.removeClass('fa-plus').addClass('fa-minus');
                }
            });
        });
    </script>

    <script>
        $('.experienceLane').owlCarousel({
            items: 2,
            lazyLoad: true,
            loop: true,
            autoplay: true,
            gap: 10,
            autoplayTimeout: 2500,
            autoplayHoverPause: true,
            responsive: {
                0: {
                    items: 1
                },
                600: {
                    items:1
                },
                960: {
                    items: 1
                },
                1200: {
                    items:1
                }
            }
        });
    </script>

    <script>
        window.addEventListener("scroll", function() {
            let scrollTop = document.documentElement.scrollTop || document.body.scrollTop;
            let scrollHeight = document.documentElement.scrollHeight - document.documentElement.clientHeight;
            let progress = (scrollTop / scrollHeight) * 100;
            let progressBar = document.getElementById("progress-bar");

            // Show progress bar only after scrolling 100px
            if (scrollTop > 100) {
                progressBar.style.opacity = "1";
                progressBar.style.visibility = "visible";
            } else {
                progressBar.style.opacity = "0";
                progressBar.style.visibility = "hidden";
            }

            if (progress >= 100) {
                progressBar.innerHTML = '<i class="fas fa-arrow-up"></i>';
                progressBar.style.background = `#a3c940`; /* Full yellow when at 100% */
                progressBar.querySelector("i").style.display = "block"; /* Show arrow icon */
            } else {
                progressBar.innerHTML = Math.round(progress) + "%";
                progressBar.style.background = `conic-gradient(#a3c940 ${progress}%, #172a5a ${progress}%)`;
            }
        });

        // Click to scroll back to top
        document.getElementById("progress-bar").addEventListener("click", function() {
            window.scrollTo({ top: 0, behavior: 'smooth' });
        });
    </script>

    <script>
